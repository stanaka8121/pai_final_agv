<?xml version="1.0" ?>
<!--
  工場内搬送AGV ワールド (Ignition Gazebo Fortress / SDF 1.8)
  ステーション配置:
    HOME   (灰) : (-4,  3)  待機・充電場所。AGVの初期位置
    PARTS  (青) : ( 4,  3)  部品置き場
    PROCESS(黄) : ( 4, -3)  加工ステーション
    SHIP   (緑) : (-4, -3)  出荷エリア
-->
<sdf version="1.8">
  <world name="factory">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- カメラセンサー用。画像が真っ黒/起動しない場合は ogre2 を ogre に変更 -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- ================= 床 ================= -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= 外壁 (12m x 12m) ================= -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_c"><pose>0 6 0.5 0 0 0</pose><geometry><box><size>12.2 0.1 1</size></box></geometry></collision>
        <visual name="north_v"><pose>0 6 0.5 0 0 0</pose><geometry><box><size>12.2 0.1 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
        <collision name="south_c"><pose>0 -6 0.5 0 0 0</pose><geometry><box><size>12.2 0.1 1</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -6 0.5 0 0 0</pose><geometry><box><size>12.2 0.1 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
        <collision name="east_c"><pose>6 0 0.5 0 0 0</pose><geometry><box><size>0.1 12.2 1</size></box></geometry></collision>
        <visual name="east_v"><pose>6 0 0.5 0 0 0</pose><geometry><box><size>0.1 12.2 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
        <collision name="west_c"><pose>-6 0 0.5 0 0 0</pose><geometry><box><size>0.1 12.2 1</size></box></geometry></collision>
        <visual name="west_v"><pose>-6 0 0.5 0 0 0</pose><geometry><box><size>0.1 12.2 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= ステーション (床マーカー＋設備) ================= -->
    <!-- HOME: 待機・充電 (灰) -->
    <model name="station_home">
      <static>true</static>
      <pose>-4 3 0 0 0 0</pose>
      <link name="link">
        <visual name="floor_mark"><pose>0 0 0.003 0 0 0</pose>
          <geometry><box><size>1.2 1.2 0.005</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="charger_c"><pose>-1.2 0 0.25 0 0 0</pose><geometry><box><size>0.3 0.6 0.5</size></box></geometry></collision>
        <visual name="charger_v"><pose>-1.2 0 0.25 0 0 0</pose><geometry><box><size>0.3 0.6 0.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.25 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- PARTS: 部品置き場 (青) -->
    <model name="station_parts">
      <static>true</static>
      <pose>4 3 0 0 0 0</pose>
      <link name="link">
        <visual name="floor_mark"><pose>0 0 0.003 0 0 0</pose>
          <geometry><box><size>1.2 1.2 0.005</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material></visual>
        <collision name="rack_c"><pose>1.2 0 0.4 0 0 0</pose><geometry><box><size>0.5 1.2 0.8</size></box></geometry></collision>
        <visual name="rack_v"><pose>1.2 0 0.4 0 0 0</pose><geometry><box><size>0.5 1.2 0.8</size></box></geometry>
          <material><ambient>0.45 0.3 0.15 1</ambient><diffuse>0.45 0.3 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- PROCESS: 加工ステーション (黄) -->
    <model name="station_process">
      <static>true</static>
      <pose>4 -3 0 0 0 0</pose>
      <link name="link">
        <visual name="floor_mark"><pose>0 0 0.003 0 0 0</pose>
          <geometry><box><size>1.2 1.2 0.005</size></box></geometry>
          <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
        <collision name="machine_c"><pose>1.3 0 0.5 0 0 0</pose><geometry><box><size>0.8 1.0 1.0</size></box></geometry></collision>
        <visual name="machine_v"><pose>1.3 0 0.5 0 0 0</pose><geometry><box><size>0.8 1.0 1.0</size></box></geometry>
          <material><ambient>0.5 0.55 0.6 1</ambient><diffuse>0.5 0.55 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- SHIP: 出荷エリア (緑) -->
    <model name="station_ship">
      <static>true</static>
      <pose>-4 -3 0 0 0 0</pose>
      <link name="link">
        <visual name="floor_mark"><pose>0 0 0.003 0 0 0</pose>
          <geometry><box><size>1.2 1.2 0.005</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material></visual>
        <collision name="pallet_c"><pose>-1.2 0 0.3 0 0 0</pose><geometry><box><size>0.5 1.2 0.6</size></box></geometry></collision>
        <visual name="pallet_v"><pose>-1.2 0 0.3 0 0 0</pose><geometry><box><size>0.5 1.2 0.6</size></box></geometry>
          <material><ambient>0.6 0.45 0.25 1</ambient><diffuse>0.6 0.45 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= AGV (差動二輪 + 前方カメラ) ================= -->
    <model name="agv">
      <pose>-4 3 0 0 0 0</pose>

      <link name="base_link">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.060</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.110</iyy><iyz>0</iyz>
            <izz>0.158</izz>
          </inertia>
        </inertial>
        <collision name="body_collision">
          <geometry><box><size>0.5 0.36 0.12</size></box></geometry>
        </collision>
        <visual name="body_visual">
          <geometry><box><size>0.5 0.36 0.12</size></box></geometry>
          <material><ambient>1.0 0.45 0.0 1</ambient><diffuse>1.0 0.45 0.0 1</diffuse></material>
        </visual>
        <visual name="deck_visual">
          <pose>0 0 0.07 0 0 0</pose>
          <geometry><box><size>0.46 0.32 0.02</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="mast_visual">
          <pose>0.22 0 0.11 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- キャスター: 摩擦ゼロの球を車体に直接付ける（ボールジョイントより安定） -->
        <collision name="caster_front">
          <pose>0.2 0 -0.06 0 0 0</pose>
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="caster_front_v">
          <pose>0.2 0 -0.06 0 0 0</pose>
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="caster_rear">
          <pose>-0.2 0 -0.06 0 0 0</pose>
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="caster_rear_v">
          <pose>-0.2 0 -0.06 0 0 0</pose>
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="left_wheel">
        <pose>0 0.2 0.08 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.000867</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000867</iyy><iyz>0</iyz>
            <izz>0.0016</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.2 0.08 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.000867</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000867</iyy><iyz>0</iyz>
            <izz>0.0016</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- 前方カメラ (AI認識用)。CPU負荷を抑えるため 320x240 / 10Hz -->
      <link name="camera_link">
        <pose>0.24 0 0.28 0 0.15 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00001</iyy><iyz>0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.04 0.08 0.04</size></box></geometry>
          <material><ambient>0.1 0.1 0.6 1</ambient><diffuse>0.1 0.1 0.6 1</diffuse></material>
        </visual>
        <sensor name="front_camera" type="camera">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <topic>/camera/image</topic>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>20</far></clip>
          </camera>
        </sensor>
      </link>
      <joint name="camera_joint" type="fixed">
        <parent>base_link</parent>
        <child>camera_link</child>
      </joint>

      <!-- 差動二輪の駆動プラグイン（サンプル記事と同じ仕組み） -->
      <plugin filename="ignition-gazebo-diff-drive-system"
              name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.4</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <min_linear_acceleration>-1.0</min_linear_acceleration>
        <max_angular_acceleration>2.0</max_angular_acceleration>
        <min_angular_acceleration>-2.0</min_angular_acceleration>
        <max_linear_velocity>0.6</max_linear_velocity>
        <min_linear_velocity>-0.6</min_linear_velocity>
        <max_angular_velocity>1.5</max_angular_velocity>
        <min_angular_velocity>-1.5</min_angular_velocity>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>20</odom_publish_frequency>
      </plugin>
    </model>

  </world>
</sdf>
